<UserControl x:Class="Eiri.Reimbursement.Desktop.ReimbursementDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,12">
            <Button x:Name="DingTalkApprovalButton" Height="32" MinWidth="90" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding CanEdit}" Click="DingTalkApproval_OnClick">
                <TextBlock Foreground="{DynamicResource PrimaryButtonTextBrush}" Text="钉钉提审"/>
            </Button>
            <Button Width="84" Height="32" Content="添加文件" IsEnabled="{Binding CanEdit}" Click="AddFiles_OnClick"/>
        </StackPanel>

        <Border x:Name="ReimbursementDropZone" Grid.Row="1"
                Margin="18,0,18,14" MinHeight="70" Padding="10"
                AllowDrop="True" IsEnabled="{Binding CanEdit}"
                Background="{DynamicResource InvoiceDropBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="1" CornerRadius="6"
                DragOver="Files_OnDragOver" Drop="Files_OnDrop"
                ToolTip="PDF 自动识别第 1 页；再次添加只补充空字段。">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="报销单文件" HorizontalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                <TextBlock Text="拖入 PDF 后自动解析首页" Margin="0,4,0,0"
                           HorizontalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <TabControl x:Name="ReimbursementDetailTabs" Grid.Row="2" Margin="12,0,12,0"
                    Style="{StaticResource DetailTabControlStyle}"
                    ItemContainerStyle="{StaticResource DetailTabItemStyle}">
            <TabItem Header="附件材料">
                <Grid Margin="6,10,6,0">
                    <ListBox x:Name="AttachmentList" ItemsSource="{Binding Attachments}"
                             BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="Attachments_OnDoubleClick" KeyDown="Attachments_OnKeyDown"
                             AutomationProperties.Name="报销单附件">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DetailMaterialCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding OriginalFileName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalFileName}" />
                                        <TextBlock Text="双击或按 Enter 打开" Margin="0,4,0,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding ProcessingError}" TextWrapping="Wrap"
                                                   FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="暂无附件，将文件拖入上方区域。" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=AttachmentList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="报销单属性">
                <ScrollViewer Margin="6,8,6,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4" IsEnabled="{Binding CanEdit}">
                        <Label Content="申请日期" Style="{StaticResource DetailFieldLabelStyle}"
                               Target="{Binding ElementName=ApplicationDateInput}" />
                        <TextBox x:Name="ApplicationDateInput" Margin="0,0,0,12"
                                 Text="{Binding ApplicationDate, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Microsoft YaHei UI" ToolTip="yyyy-MM-dd" />
                        <Label Content="报销类型" Style="{StaticResource DetailFieldLabelStyle}"
                               Target="{Binding ElementName=TypeInput}" />
                        <TextBox x:Name="TypeInput" Margin="0,0,0,12"
                                 Text="{Binding ReimbursementType, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Content="报销内容" Style="{StaticResource DetailFieldLabelStyle}"
                               Target="{Binding ElementName=ContentInput}" />
                        <TextBox x:Name="ContentInput" Height="72" Margin="0,0,0,12"
                                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        <Label Content="总金额（元）" Style="{StaticResource DetailFieldLabelStyle}"
                               Target="{Binding ElementName=AmountInput}" />
                        <TextBox x:Name="AmountInput" Margin="0,0,0,12"
                                 FontFamily="Cascadia Mono, Microsoft YaHei UI"
                                 Text="{Binding TotalAmount, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Content="钉钉审批实例 ID" Style="{StaticResource DetailFieldLabelStyle}" Target="{Binding ElementName=DingTalkInstanceIdOutput}"/>
                        <TextBox x:Name="DingTalkInstanceIdOutput" Text="{Binding DingTalkInstanceId, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" AutomationProperties.Name="钉钉审批实例 ID"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="关联订单">
                <ScrollViewer Margin="6,10,6,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
                    <Border Style="{StaticResource DetailMaterialCardStyle}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding OrderSummary}" TextWrapping="Wrap" />
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="提交/返款状态">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,10,6,0">
                        <Border Padding="14" Margin="0,0,0,12"
                                Background="{DynamicResource SubtlePanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="导出" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ExportedDisplay}" Margin="0,4,0,0" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Content="已导出"
                                          IsChecked="{Binding IsExported, Mode=OneWay}"
                                          IsEnabled="False" />
                            </Grid>
                        </Border>
                        <Border Padding="14" Margin="0,0,0,12"
                                Background="{DynamicResource SubtlePanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="提交" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SubmittedDisplay}" Margin="0,4,0,0" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Content="已提交"
                                          IsChecked="{Binding IsSubmitted, Mode=OneWay}"
                                          IsEnabled="{Binding CanEdit}" Tag="Submitted" Click="Milestone_OnClick" />
                            </Grid>
                        </Border>
                        <Border Padding="14" Margin="0,0,0,12"
                                Background="{DynamicResource SubtlePanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="返款" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RefundedDisplay}" Margin="0,4,0,0" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Content="已返款"
                                          IsChecked="{Binding IsRefunded, Mode=OneWay}"
                                          IsEnabled="{Binding CanEdit}" Tag="Refunded" Click="Milestone_OnClick" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="18,8,18,0"
                   TextWrapping="Wrap" MaxHeight="60" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
