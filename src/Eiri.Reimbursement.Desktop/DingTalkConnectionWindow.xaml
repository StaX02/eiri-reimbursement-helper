<Window x:Class="Eiri.Reimbursement.Desktop.DingTalkConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowFrameStyle}"
        Title="连接钉钉接口" Width="520" Height="360" MinWidth="420" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Grid Grid.Row="1">
            <StackPanel>
                <Label Content="AccessToken" Target="{Binding ElementName=AccessTokenOutput}" Padding="0,0,0,6"/>
                <TextBox x:Name="AccessTokenOutput" Text="{Binding AccessToken, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         Height="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="AccessToken"/>
                <TextBlock Text="{Binding ExpirationText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
            <Border Background="{DynamicResource SurfaceBrush}" Visibility="{Binding HasError, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock x:Name="StatusText" Text="{Binding ErrorMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ReimportButton" Content="重新导入凭据" Click="Reimport_OnClick" Visibility="{Binding HasError, Converter={StaticResource VisibleWhenTrue}}"/>
            <Button Content="关闭" MinWidth="88" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
