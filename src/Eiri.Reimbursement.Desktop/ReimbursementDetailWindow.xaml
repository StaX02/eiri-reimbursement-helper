<Window x:Class="Eiri.Reimbursement.Desktop.ReimbursementDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="报销单详情" Width="620" Height="760" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="报销单详情" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding CanEdit}">
                <Label Content="申请日期" Target="{Binding ElementName=ApplicationDateInput}"/>
                <TextBox x:Name="ApplicationDateInput" Text="{Binding ApplicationDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="yyyy-MM-dd"/>
                <Label Content="报销类型" Target="{Binding ElementName=TypeInput}"/>
                <TextBox x:Name="TypeInput" Text="{Binding ReimbursementType, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="报销内容" Target="{Binding ElementName=ContentInput}"/>
                <TextBox x:Name="ContentInput" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70"/>
                <Label Content="总金额（元）" Target="{Binding ElementName=AmountInput}"/>
                <TextBox x:Name="AmountInput" Text="{Binding TotalAmount, UpdateSourceTrigger=PropertyChanged}"/>
                <Expander Header="关联订单" Margin="0,16,0,12"><TextBlock Text="{Binding OrderSummary}" TextWrapping="Wrap"/></Expander>
                <Border AllowDrop="True" DragOver="Files_OnDragOver" Drop="Files_OnDrop" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SupportingDropBrush}" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="将报销单文件拖到这里" FontWeight="SemiBold"/>
                        <TextBlock Text="PDF 自动识别第 1 页；再次添加只补充空字段。" TextWrapping="Wrap" Margin="0,6,0,10"/>
                        <Button Content="添加文件" Click="AddFiles_OnClick" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="附件（双击打开）" Margin="0,14,0,6"/>
                <ListBox x:Name="AttachmentList" ItemsSource="{Binding Attachments}" MaxHeight="180" MouseDoubleClick="Attachments_OnDoubleClick" KeyDown="Attachments_OnKeyDown" AutomationProperties.Name="报销单附件">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel>
                        <TextBlock Text="{Binding OriginalFileName}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ProcessingError}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxHeight="85" AutomationProperties.LiveSetting="Polite"/>
            <Button Content="保存" IsEnabled="{Binding CanEdit}" Click="Save_OnClick" HorizontalAlignment="Right" Width="90" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>
