<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.3.0</Version>
    <UseWPF>true</UseWPF>
    <RootNamespace>Eiri.Reimbursement.Desktop</RootNamespace>
    <DocumentWorkerProjectDir>$(MSBuildProjectDirectory)\..\..\worker\document-worker</DocumentWorkerProjectDir>
    <DocumentWorkerPublishDir>$(MSBuildProjectDirectory)\obj\document-worker</DocumentWorkerPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eiri.Reimbursement.Core\Eiri.Reimbursement.Core.csproj" />
    <ProjectReference Include="..\Eiri.Reimbursement.Infrastructure\Eiri.Reimbursement.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\StaX02.png" />
  </ItemGroup>

  <Target Name="PublishBundledDocumentWorker" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(DocumentWorkerProjectDir)\build-worker.ps1&quot; -OutputDirectory &quot;$(DocumentWorkerPublishDir)&quot;" />
    <ItemGroup>
      <DocumentWorkerPublishFile Include="$(DocumentWorkerPublishDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DocumentWorkerPublishFile)" DestinationFiles="@(DocumentWorkerPublishFile->'$(PublishDir)document-worker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
