<Window x:Class="Eiri.Reimbursement.Desktop.BatchInvoiceImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量导入发票"
        Width="540"
        Height="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="批量导入发票" />
            <TextBlock Margin="0,6,0,0" Foreground="#667085" TextWrapping="Wrap">
                <Run Text="每份 PDF 将创建一个独立订单并自动解析。订单平台：" />
                <Run FontWeight="SemiBold" Text="{Binding SelectedPlatform.DisplayName}" />
            </TextBlock>
        </StackPanel>

        <Border x:Name="BatchInvoiceDropZone"
                Grid.Row="1"
                Padding="24"
                AllowDrop="True"
                Background="#F0F7FF"
                BorderBrush="#1570EF"
                BorderThickness="1"
                CornerRadius="8"
                DragOver="BatchInvoiceDropZone_OnDragOver"
                Drop="BatchInvoiceDropZone_OnDrop">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="拖入一个或多个发票 PDF" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#475467"
                           Text="松开后立即创建订单并解析" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <ProgressBar x:Name="ImportProgress"
                         Height="5"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
            <TextBlock x:Name="ImportStatusText"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Foreground="#667085"
                       Text="等待拖入发票…" />
        </StackPanel>
    </Grid>
</Window>
