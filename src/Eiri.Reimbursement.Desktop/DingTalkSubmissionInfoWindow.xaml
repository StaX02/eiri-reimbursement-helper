<Window x:Class="Eiri.Reimbursement.Desktop.DingTalkSubmissionInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="报销提审信息" Width="560" Height="680" MinWidth="400" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="PrefillScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="报销人所属部门" Target="{Binding ElementName=DepartmentInput}" Padding="0,0,0,6"/>
        <Grid Grid.Row="1">
            <ComboBox x:Name="DepartmentInput" Height="36" ItemsSource="{Binding Departments}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedDepartment, Mode=OneWay}" IsEnabled="{Binding CanSelectDepartment}"
                      AutomationProperties.Name="报销人所属部门" MaxDropDownHeight="260"
                      DropDownOpened="Department_OnOpened" SelectionChanged="Department_OnChanged"/>
            <TextBlock Text="待选择..." Margin="10,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource SecondaryTextBrush}">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedDepartment}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </Grid>
        <Label Grid.Row="2" Content="报销人" Target="{Binding ElementName=UserInput}" Padding="0,14,0,6"/>
        <Grid Grid.Row="3">
            <ComboBox x:Name="UserInput" Height="36" ItemsSource="{Binding Users}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedUser, Mode=OneWay}" IsEnabled="{Binding CanSelectUser}"
                      AutomationProperties.Name="报销人" MaxDropDownHeight="260"
                      DropDownOpened="User_OnOpened" SelectionChanged="User_OnChanged"/>
            <TextBlock Text="待选择..." Margin="10,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource SecondaryTextBrush}">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedUser}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </Grid>
        <ItemsControl Grid.Row="4" x:Name="FormFieldsList" ItemsSource="{Binding FormFields}" IsEnabled="{Binding CanSelectDepartment}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}">
                            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsText}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsMultiline}" Value="True"><Setter Property="Height" Value="88"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></DataTrigger>
                                </Style.Triggers>
                            </Style></TextBox.Style>
                        </TextBox>
                        <Grid>
                            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSingleChoice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                            <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Value" SelectedItem="{Binding SelectedChoice}" MaxDropDownHeight="260" AutomationProperties.Name="{Binding Label}"/>
                            <TextBlock Text="待选择..." Margin="10,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource SecondaryTextBrush}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedChoice}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox ItemsSource="{Binding Choices}" Text="{Binding SelectionSummary, Mode=OneWay}" SelectionChanged="MultiChoice_OnSelectionChanged" MaxDropDownHeight="260" AutomationProperties.Name="{Binding Label}">
                            <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMultipleChoice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                            <ComboBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="0,12,0,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="重新加载" Click="ReloadForm_OnClick" IsEnabled="{Binding CanSelectDepartment}" MinWidth="88"/>
            <Button Content="保存" Click="SaveForm_OnClick" IsEnabled="{Binding CanSelectDepartment}" MinWidth="88" Margin="8,0,0,0"/>
            <Button Content="关闭" MinWidth="88" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
