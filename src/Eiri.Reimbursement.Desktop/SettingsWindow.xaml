<Window x:Class="Eiri.Reimbursement.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowFrameStyle}"
        Title="设置" Width="820" Height="760" MinWidth="660" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="SettingsBody">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="Categories" SelectedIndex="0" SelectionChanged="Category_OnChanged"
                     BorderThickness="0" Background="Transparent" Margin="0,0,16,0"
                     AutomationProperties.Name="设置项">
                <ListBoxItem Content="钉钉" Padding="12"/>
                <ListBoxItem Content="导出" Padding="12"/>
            </ListBox>
            <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>
            <Grid Grid.Column="2" Margin="24,0,0,0">
                <ScrollViewer x:Name="DingTalkScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
                <Grid x:Name="DingTalkPanel" MinHeight="580" Height="{Binding ActualHeight, ElementName=DingTalkScroll}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="连接" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel x:Name="ConnectionPanel">
                            <TextBlock Text="{Binding StatusText}" Margin="0,0,0,8"/>
                            <Label Content="连接凭据（AccessToken）" Target="{Binding ElementName=CredentialOutput}" Padding="0,0,0,6"/>
                            <TextBox x:Name="CredentialOutput" IsReadOnly="True" Height="64" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="连接凭据"/>
                            <CheckBox x:Name="ShowCredential" Content="显示连接凭据" Margin="0,8,0,0"
                                      Checked="CredentialVisibility_OnChanged" Unchecked="CredentialVisibility_OnChanged"/>
                            <TextBlock Text="{Binding ExpirationText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <WrapPanel Margin="0,12,0,20">
                            <Button x:Name="ConnectButton" Content="连接接口" Click="Connect_OnClick" Margin="0,0,12,0"/>
                            <Button Content="清除连接记录" Click="Clear_OnClick" Foreground="{DynamicResource DangerBrush}"/>
                        </WrapPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="提审信息" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ContentControl x:Name="SubmissionContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </Grid>
                </Grid>
                </ScrollViewer>
                <ScrollViewer x:Name="ExportPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="导出" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <Label Content="报销资料默认导出位置" Target="{Binding ElementName=ExportDirectoryOutput}" Padding="0,0,0,8"/>
                        <TextBox x:Name="ExportDirectoryOutput" IsReadOnly="True" TextWrapping="Wrap" MinHeight="64"
                                 AutomationProperties.Name="报销资料默认导出位置"/>
                        <WrapPanel Margin="0,12,0,12">
                            <Button Content="选择文件夹" Click="ChooseDirectory_OnClick" Margin="0,0,12,0"/>
                            <Button Content="清除默认位置" Click="ResetDirectory_OnClick"/>
                        </WrapPanel>
                        <TextBlock Text="选择后自动保存。导出报销资料和审批 PDF 时使用此文件夹；未设置时，每次导出选择位置。"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            <Button Grid.Column="1" Content="关闭" IsCancel="True" MinWidth="88"/>
        </Grid>
    </Grid>
</Window>
