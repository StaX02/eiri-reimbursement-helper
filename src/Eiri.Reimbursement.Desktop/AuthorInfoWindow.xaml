<Window x:Class="Eiri.Reimbursement.Desktop.AuthorInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="作者信息"
        Width="360"
        Height="360"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="36,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image x:Name="AuthorAvatar"
               Grid.Row="0"
               Width="144"
               Height="144"
               HorizontalAlignment="Center"
               Stretch="UniformToFill"
               Source="/Eiri.Reimbursement.Desktop;component/Assets/StaX02.png" />

        <TextBlock x:Name="AuthorName"
                   Grid.Row="1"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Center"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Text="StaX" />

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center">
            <Hyperlink x:Name="AuthorGitHubLink"
                       NavigateUri="https://github.com/StaX02"
                       RequestNavigate="GitHubLink_OnRequestNavigate">https://github.com/StaX02</Hyperlink>
        </TextBlock>

        <Button Grid.Row="4"
                Width="88"
                Height="34"
                HorizontalAlignment="Center"
                IsDefault="True"
                IsCancel="True"
                Content="关闭" />
    </Grid>
</Window>
