<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Eiri Reimbursement Helper"
      Manufacturer="StaX02"
      Version="$(var.ProductVersion)"
      UpgradeCode="{CA55F813-CFE8-4525-840B-72E300503353}"
      Language="2052"
      Scope="perMachine"
      InstallerVersion="500"
      Compressed="yes">

    <SummaryInformation
        Description="Eiri 发票报销助手"
        Manufacturer="StaX02" />

    <MajorUpgrade
        DowngradeErrorMessage="已安装更新版本的 Eiri Reimbursement Helper。"
        Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ProductIcon" SourceFile="..\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/StaX02/eiri-reimbursement-helper" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="DATADIRECTORY" Secure="yes" />
    <Property Id="ADDDESKTOPSHORTCUT" Secure="yes" />
    <Property Id="DELETEAPPDATA" Secure="yes" />

    <Binary Id="InstallerActions" SourceFile="$(var.CustomActions.TargetDir)CustomActions.CA.dll" />
    <CustomAction Id="LoadSettings" BinaryRef="InstallerActions" DllEntry="LoadSettings" Execute="firstSequence" Return="check" />
    <CustomAction Id="ConfigureInstall" BinaryRef="InstallerActions" DllEntry="ConfigureInstall" Execute="firstSequence" Return="check" />
    <CustomAction Id="ValidateSettings" BinaryRef="InstallerActions" DllEntry="ValidateSettings" Return="check" />
    <CustomAction Id="PrepareDataRemoval" BinaryRef="InstallerActions" DllEntry="PrepareDataRemoval" Return="check" />
    <CustomAction Id="DeleteApplicationData" BinaryRef="InstallerActions" DllEntry="DeleteApplicationData" Execute="commit" Impersonate="yes" Return="check" />

    <InstallUISequence>
      <Custom Action="LoadSettings" Before="CostInitialize" />
      <Custom Action="ConfigureInstall" After="LoadSettings" Condition="NOT Installed AND NOT REMOVE AND UILevel &gt;= 3" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="LoadSettings" Before="CostInitialize" />
      <Custom Action="ConfigureInstall" After="LoadSettings" Condition="NOT Installed AND NOT REMOVE AND UILevel &gt;= 3" />
      <Custom Action="ValidateSettings" After="ConfigureInstall" Condition="NOT REMOVE" />
      <Custom Action="PrepareDataRemoval" Before="InstallInitialize" Condition="Installed AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="DeleteApplicationData" Before="InstallFinalize" Condition="Installed AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND DELETEAPPDATA = &quot;1&quot;" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ManufacturerFolder" Name="StaX02">
        <Directory Id="INSTALLFOLDER" Name="Eiri Reimbursement Helper" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{EE747B39-433B-4368-9DD2-9630BC0D5B0A}" Condition="ADDDESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="ApplicationDesktopShortcut" Name="Eiri Reimbursement Helper" Target="[INSTALLFOLDER]Eiri.Reimbursement.Desktop.exe" WorkingDirectory="INSTALLFOLDER" Icon="ProductIcon" />
        <RegistryValue Root="HKCU" Key="Software\StaX02\Eiri Reimbursement Helper" Name="DesktopShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstallSettings" Guid="{7F8154A0-5892-49A3-953B-2F8E9A3C3112}">
        <RegistryValue Root="HKLM" Key="Software\StaX02\Eiri Reimbursement Helper" Name="InstallDirectory" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\StaX02\Eiri Reimbursement Helper" Name="DesktopShortcut" Type="string" Value="[ADDDESKTOPSHORTCUT]" />
      </Component>
      <Component Id="UserDataSettings" Guid="{CC9A1142-0A09-4B25-8850-8B340CE21820}" Permanent="yes">
        <RegistryValue Root="HKCU" Key="Software\StaX02\Eiri Reimbursement Helper" Name="DataDirectory" Type="string" Value="[DATADIRECTORY]" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Eiri Reimbursement Helper">
        <Component Id="ApplicationShortcut" Guid="{3E55E910-10EE-4402-816D-653F4FAC40CC}">
          <Shortcut
              Id="ApplicationStartMenuShortcut"
              Name="Eiri Reimbursement Helper"
              Description="整理电子发票材料并跟踪报销进度"
              Target="[INSTALLFOLDER]Eiri.Reimbursement.Desktop.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="ProductIcon" />
          <RemoveFolder
              Id="RemoveApplicationProgramsFolder"
              Directory="ApplicationProgramsFolder"
              On="uninstall" />
          <RegistryValue
              Root="HKCU"
              Key="Software\StaX02\Eiri Reimbursement Helper"
              Name="Installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="PublishedFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDirectory)\**">
        <Exclude Files="$(var.PublishDirectory)\Eiri.Reimbursement.Desktop.exe" />
        <Exclude Files="$(var.PublishDirectory)\*.pdb" />
      </Files>
      <Component Id="MainExecutableComponent">
        <File
            Id="EiriReimbursementDesktopExe"
            Source="$(var.PublishDirectory)\Eiri.Reimbursement.Desktop.exe"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Complete" Title="Eiri Reimbursement Helper" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="InstallSettings" />
      <ComponentRef Id="UserDataSettings" />
    </Feature>
  </Package>
</Wix>
